# Copy to publisher/.env (never commit it).
GITHUB_REPO=kevinandrin7-start/ReelGen
# Fine-grained token for this repo only: Contents read and write
GITHUB_TOKEN=github_pat_...
# Same Google OAuth values as the GitHub secrets
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
# The only accounts the publisher may post from (it checks before every upload)
YOUTUBE_HANDLE=@BrainBytesDaily-q9h
INSTAGRAM_HANDLE=brain.bytesdaily
